---
interface Props {
  nombre: string;
  descripcion: string;
  imagen: string;
}

const { nombre, descripcion, imagen } = Astro.props;
---
<div class="tarjeta">
  <img src={imagen} alt={nombre} />
  <div class="contenido">
    <h3>{nombre}</h3>
    <p>{descripcion}</p>
  </div>
</div>

<style>
  .tarjeta {
    border: 1px solid #ddd;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    background: white;
  }
  .tarjeta img {
    width: 100%;
    height: 180px;
    object-fit: cover;
  }
  .contenido {
    padding: 1rem;
  }
  .contenido h3 {
    margin-top: 0;
    color: #2c3e50;
  }
</style>