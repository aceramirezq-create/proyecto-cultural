---
import Layout from '../layouts/Layout.astro';
import TarjetaTaller from '../components/TarjetaTaller.astro';

// Importación de las 4 imágenes desde src/img/
import img1 from '../img/1.svg';
import img2 from '../img/2.svg';
import img3 from '../img/3.svg';
import img4 from '../img/4.svg';
---

<Layout titulo="Nuestros Talleres">
  <h1>Nuestros Talleres</h1>
  <p>Descubre todas nuestras actividades disponibles para la comunidad.</p>

  <div class="grid-talleres">
    <TarjetaTaller 
      nombre="Fotografía" 
      descripcion="Introducción a la composición y técnicas de fotografía digital." 
      imagen={img1.src} 
    />
    <TarjetaTaller 
      nombre="Cerámica" 
      descripcion="Creación de objetos utilizando técnicas básicas de modelado." 
      imagen={img2.src} 
    />
    <TarjetaTaller 
      nombre="Escritura creativa" 
      descripcion="Exploración de relatos breves y ejercicios de escritura." 
      imagen={img3.src} 
    />
    <TarjetaTaller 
      nombre="Ilustración" 
      descripcion="Desarrollo de habilidades de dibujo e ilustración digital." 
      imagen={img4.src} 
    />
  </div>
</Layout>