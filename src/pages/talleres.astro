---
import Layout from '../layouts/Layout.astro';
---
<Layout titulo="Nuestros Talleres">
  <h1>Nuestros Talleres</h1>
  <p>Descubre todas nuestras actividades disponibles para la comunidad.</p>

  <div class="grid-talleres">
    <article class="tarjeta-taller">
      <img src="/src/img/fotografia.jpg" alt="Fotografía" />
      <h2>Fotografía</h2>
      <p>Introducción a la composición y técnicas de fotografía digital.</p>
    </article>
    <article class="tarjeta-taller">
      <img src="/src/img/ceramica.jpg" alt="Cerámica" />
      <h2>Cerámica</h2>
      <p>Creación de objetos utilizando técnicas básicas de modelado.</p>
    </article>
    <article class="tarjeta-taller">
      <img src="/src/img/escritura.jpg" alt="Escritura creativa" />
      <h2>Escritura creativa</h2>
      <p>Exploración de relatos breves y ejercicios de escritura.</p>
    </article>
    <article class="tarjeta-taller">
      <img src="/src/img/ilustracion.jpg" alt="Ilustración" />
      <h2>Ilustración</h2>
      <p>Desarrollo de habilidades de dibujo e ilustración digital.</p>
    </article>
  </div>
</Layout>