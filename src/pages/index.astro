---
import Layout from '../layouts/Layout.astro';
import TarjetaTaller from '../components/TarjetaTaller.astro';

// Importación de imágenes nombradas del 1 al 3 desde src/img/
import img1 from '../img/1.svg';
import img2 from '../img/2.svg';
import img3 from '../img/3.svg';
---

<Layout titulo="Inicio">
  <section class="bienvenida">
    <h1>Bienvenidos a Espacio Cultural</h1>
    <p>Un punto de encuentro para el arte, la creatividad y la comunidad.</p>
  </section>

  <h2>Talleres Destacados</h2>
  <div class="grid-talleres">
    <TarjetaTaller 
      nombre="Fotografía" 
      descripcion="Introducción a la composición y técnicas de fotografía digital." 
      imagen={img1.src} 
    />
    <TarjetaTaller 
      nombre="Cerámica" 
      descripcion="Creación de objetos utilizando técnicas básicas de modelado." 
      imagen={img2.src} 
    />
    <TarjetaTaller 
      nombre="Escritura creativa" 
      descripcion="Exploración de relatos breves y ejercicios de escritura." 
      imagen={img3.src} 
    />
  </div>
</Layout>